 "topology": {
  "links": []
 },
 "detector": {
  "type": "mediapipe",
  "model": "efficientdet_lite0",
  "delegate": "cpu",
  "score_threshold": 0.45,
  "classes": [
   "person",
   "car",
   "truck",
   "bus",
   "motorcycle",
   "bicycle",
   "dog",
   "cat"
  ],
  "min_box_area": 0.0015,
  "idle_detect_interval_s": 1.0
 },
 "tracker": {
  "iou_threshold": 0.25,
  "min_hits": 3,
  "max_missed_ms": 2500
 },
 "engine": {
  "zone_enter_ms": 600,
  "zone_exit_ms": 1500,
  "presence_grace_ms": 5000
 },
 "correlation": {
  "reacquire_s": 4,
  "min_link_confidence": 0.5,
  "ambiguity_margin": 0.15
 },
 "rules": [
  {
   "id": "restricted_entry",
   "type": "zone_entry",
   "zone_types": [
    "restricted"
   ],
   "classes": [
    "person"
   ],
   "severity": "high"
  },
  {
   "id": "linger_30s",
   "type": "dwell",
   "zone_types": [
    "entrance",
    "yard",
    "driveway",
    "perimeter",
    "general"
   ],
   "classes": [
    "person"
   ],
   "min_dwell_s": 30,
   "severity": "medium"
  },
  {
   "id": "repeated_entrance",
   "type": "repeated_presence",
   "zone_types": [
    "entrance"
   ],
   "classes": [
    "person"
   ],
   "count": 3,
   "window_s": 120,
   "severity": "medium"
  },
  {
   "id": "vehicle_stop",
   "type": "dwell",
   "zone_types": [
    "driveway"
   ],
   "classes": [
    "vehicle"
   ],
   "min_dwell_s": 30,
   "require_arrival": true,
   "severity": "low"
  }
 ],
 "incidents": {
  "merge_window_s": 120,
  "close_after_s": 60,
  "corroboration_behaviors": 3
 },
 "alerts": {
  "notify_min_severity": {
   "disarmed": "none",
   "home": "high",
   "away": "medium"
  },
  "max_notifications": 6,
  "rate_window_s": 600,
  "channels": []
 },
 "recording": {
  "enabled": false
 },
 "privacy": {
  "store_clips": false,
  "store_snapshots": false,
  "retention_days": {
   "events": 30,
   "media": 7
  }
 },
 "health": {
  "camera_offline_after_s": 60
 },
 "storage": {
  "dir": "bench_runs/_live_store"
 },
 "settings_defaults": {
  "arm_mode": "away",
  "sensitivity": "normal",
  "notifications_enabled": true
 },
 "drone": {
  "enabled": false
 },
 "_comment": "Publish test streams with MediaMTX + ffmpeg (see docs/benchmarking.md). For a real camera set the source to {\"type\": \"rtsp\", \"url\": \"rtsp://user:$-{CAM_PASS}@192.168.1.20:554/stream2\"} (without the dash: env var substitution) or {\"type\": \"usb\", \"index\": 0}."
}